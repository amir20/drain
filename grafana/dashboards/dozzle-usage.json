          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH\n  activation AS (\n    SELECT client_id, min(day) AS activated\n    FROM daily_client_events\n    WHERE client_id <> ''\n    GROUP BY client_id\n  ),\n  last_seen AS (\n    SELECT client_id, max(day) AS last_day\n    FROM daily_client_events\n    WHERE client_id <> ''\n    GROUP BY 1\n  )\nSELECT date_trunc('week', activated) AS time, 'New installs' AS metric, count(*)::bigint AS value\nFROM activation\nWHERE $__timeFilter(activated)\nGROUP BY 1\nUNION ALL\nSELECT date_trunc('week', last_day) AS time, 'Installs lost' AS metric, -count(*)::bigint AS value\nFROM last_seen\nWHERE $__timeFilter(last_day)\n  AND last_day < now() - interval '28 days'\nGROUP BY 1\nORDER BY 1;",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
