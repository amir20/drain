          "rawSql": "WITH first_start AS (\n    SELECT client_id, min(day) AS first_day\n    FROM daily_client_starts\n    WHERE client_id <> ''\n    GROUP BY 1\n  ),\n  ever_active AS (\n    SELECT DISTINCT client_id FROM daily_client_events WHERE client_id <> ''\n  )\nSELECT date_trunc('week', f.first_day) AS time,\n       CASE WHEN a.client_id IS NULL THEN 'Launch only' ELSE 'Became active' END AS metric,\n       count(*)::bigint AS value\nFROM first_start f\nLEFT JOIN ever_active a ON a.client_id = f.client_id\nWHERE $__timeFilter(f.first_day)\nGROUP BY 1, 2\nORDER BY 1;",
