          "rawQuery": true,
          "rawSql": "WITH\n  wk AS (\n    SELECT DISTINCT ON (client_id, date_trunc('week', day))\n           date_trunc('week', day) AS week,\n           client_id,\n           coalesce(nullif(substring(last_metadata->>'version' from '^v?[0-9]+[.][0-9]+'), ''), 'unknown') AS version\n    FROM daily_client_events\n    WHERE client_id <> '' AND $__timeFilter(day)\n    ORDER BY client_id, date_trunc('week', day), day DESC\n  ),\n  top AS (\n    SELECT version FROM wk\n    WHERE week > (SELECT max(week) FROM wk) - interval '28 days'\n    GROUP BY 1 ORDER BY count(*) DESC LIMIT 7\n  ),\n  labelled AS (\n    SELECT week, CASE WHEN version IN (SELECT version FROM top) THEN version ELSE 'Other' END AS version\n    FROM wk\n  ),\n  totals AS (SELECT week, count(*) AS total FROM labelled GROUP BY 1)\nSELECT l.week AS time, l.version AS metric, round(100.0 * count(*) / t.total, 2) AS value\nFROM labelled l\nJOIN totals t ON t.week = l.week\nGROUP BY 1, 2, t.total\nORDER BY 1;",
