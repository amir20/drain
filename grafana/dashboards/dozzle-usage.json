          "rawSql": "WITH peaks AS (\n    SELECT date_trunc('week', day) AS week, client_id,\n           max(coalesce((last_metadata->>'clients')::int, 0)) AS peak\n    FROM daily_client_events\n    WHERE client_id <> '' AND $__timeFilter(day)\n    GROUP BY 1, 2\n  )\nSELECT week AS time, 'Average' AS metric, round(avg(peak), 2) AS value\nFROM peaks GROUP BY 1\nUNION ALL\nSELECT week AS time, '95th percentile' AS metric,\n       round(percentile_cont(0.95) WITHIN GROUP (ORDER BY peak)::numeric, 2) AS value\nFROM peaks GROUP BY 1\nORDER BY 1;",
          "refId": "A",
          "sql": {
