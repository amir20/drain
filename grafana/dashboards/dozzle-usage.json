      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH d AS (\n    SELECT client_id, day::date AS day\n    FROM daily_client_events\n    WHERE client_id <> ''\n      AND day >  $__timeFrom()::timestamptz - interval '28 days'\n      AND day <= $__timeTo()::timestamptz\n  ),\n  w(win, label) AS (VALUES (1, 'Daily active'), (7, 'Weekly active'), (28, 'Monthly active')),\n  marked AS (\n    SELECT w.win, w.label, d.client_id, d.day,\n           CASE WHEN d.day - lag(d.day) OVER (PARTITION BY w.win, d.client_id ORDER BY d.day) > w.win\n                THEN 1 ELSE 0 END AS gap\n    FROM d CROSS JOIN w\n  ),\n  grouped AS (\n    SELECT win, label, client_id, day,\n           sum(gap) OVER (PARTITION BY win, client_id ORDER BY day) AS run\n    FROM marked\n  ),\n  spans AS (\n    SELECT win, label, min(day) AS opens, max(day) + win AS closes\n    FROM grouped GROUP BY win, label, client_id, run\n  ),\n  edges AS (\n    SELECT win, label, opens AS day,  1 AS delta FROM spans\n    UNION ALL\n    SELECT win, label, closes,       -1        FROM spans\n  ),\n  netted AS (SELECT win, label, day, sum(delta) AS delta FROM edges GROUP BY 1, 2, 3),\n  -- MATERIALIZED matters: the final SELECT reaches into `cum` from a correlated\n  -- subquery, and a single-reference CTE is inlined by default - which re-ran this\n  -- whole chain once per output day (343s vs ~6s).\n  cum AS MATERIALIZED (\n    SELECT win, label, day, sum(delta) OVER (PARTITION BY win ORDER BY day) AS v\n    FROM netted\n  ),\n  grid AS (\n    SELECT generate_series(\n             date_trunc('day', $__timeFrom()::timestamptz),\n             -- Stop at the last *complete* day; today's bucket is still filling and\n             -- would render as a cliff down to near zero.\n             LEAST(date_trunc('day', $__timeTo()::timestamptz),\n                   date_trunc('day', now()) - interval '1 day'),\n             interval '1 day')::date AS day\n  )\nSELECT g.day::timestamptz AS time,\n       l.label AS metric,\n       (SELECT c.v FROM cum c WHERE c.win = l.win AND c.day <= g.day ORDER BY c.day DESC LIMIT 1) AS value\nFROM grid g\nCROSS JOIN (VALUES (1, 'Daily active'), (7, 'Weekly active'), (28, 'Monthly active')) AS l(win, label)\nORDER BY 1;",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ]
    },
