          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH\n  wk AS (\n    SELECT DISTINCT ON (client_id, date_trunc('week', day))\n           date_trunc('week', day) AS week,\n           client_id,\n           (last_metadata->>'runningContainers')::int AS c\n    FROM daily_client_events\n    WHERE client_id <> '' AND $__timeFilter(day)\n    ORDER BY client_id, date_trunc('week', day), day DESC\n  ),\n  bucketed AS (SELECT week, CASE\n             WHEN c IS NULL THEN '7 - unknown'\n             WHEN c = 0     THEN '1 - none'\n             WHEN c <= 5    THEN '2 - 1 to 5'\n             WHEN c <= 20   THEN '3 - 6 to 20'\n             WHEN c <= 50   THEN '4 - 21 to 50'\n             WHEN c <= 200  THEN '5 - 51 to 200'\n             ELSE '6 - over 200'\n           END AS bucket FROM wk),\n  totals AS (SELECT week, count(*) AS total FROM bucketed GROUP BY 1)\nSELECT b.week AS time, b.bucket AS metric, round(100.0 * count(*) / t.total, 2) AS value\nFROM bucketed b\nJOIN totals t ON t.week = b.week\nGROUP BY 1, 2, t.total\nORDER BY 1;",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
