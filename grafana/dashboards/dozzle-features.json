          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH\n  wk AS (\n    SELECT DISTINCT ON (client_id, date_trunc('week', day))\n           date_trunc('week', day) AS week,\n           client_id,\n           last_metadata AS m\n    FROM daily_client_events\n    WHERE client_id <> '' AND $__timeFilter(day)\n    ORDER BY client_id, date_trunc('week', day), day DESC\n  ),\n  f AS (\n    SELECT wk.week, t.feature, t.enabled\n    FROM wk\n    CROSS JOIN LATERAL (VALUES\n      ('Container actions', coalesce((wk.m->>'hasActions')::boolean, false)),\n      ('Authentication', coalesce(nullif(wk.m->>'authProvider', ''), 'none') <> 'none'),\n      ('Custom hostname', coalesce((wk.m->>'hasHostname')::boolean, false)),\n      ('Custom address', coalesce((wk.m->>'hasCustomAddress')::boolean, false)),\n      ('Custom base path', coalesce((wk.m->>'hasCustomBase')::boolean, false)),\n      ('Multiple browsers', coalesce((wk.m->>'clients')::int, 0) > 1)\n    ) AS t(feature, enabled)\n  )\nSELECT week AS time, feature AS metric,\n       round(100.0 * count(*) FILTER (WHERE enabled) / count(*), 2) AS value\nFROM f\nGROUP BY 1, 2\nORDER BY 1;",
