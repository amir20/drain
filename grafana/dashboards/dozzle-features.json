          "rawSql": "WITH\n  latest AS (\n    SELECT DISTINCT ON (client_id) client_id, last_metadata AS m\n    FROM daily_client_events\n    WHERE client_id <> '' AND $__timeFilter(day)\n    ORDER BY client_id, day DESC\n  ),\n  bucketed AS (\n    SELECT m, CASE\n             WHEN c IS NULL THEN 'Unknown'\n             WHEN c = 0     THEN 'None'\n             WHEN c <= 5    THEN '1-5'\n             WHEN c <= 20   THEN '6-20'\n             WHEN c <= 50   THEN '21-50'\n             WHEN c <= 200  THEN '51-200'\n             ELSE 'Over 200'\n           END AS bucket,\n           CASE WHEN c IS NULL THEN 7 WHEN c = 0 THEN 1 WHEN c <= 5 THEN 2\n                WHEN c <= 20 THEN 3 WHEN c <= 50 THEN 4 WHEN c <= 200 THEN 5 ELSE 6 END AS ord\n    FROM (SELECT m, (m->>'runningContainers')::int AS c FROM latest) x\n  )\nSELECT bucket AS \"Deployment size\",\n       count(*)::bigint AS \"Installs\",\n       round(100.0 * count(*) FILTER (WHERE coalesce((m->>'hasActions')::boolean, false)) / count(*), 1) AS \"Actions\",\n       round(100.0 * count(*) FILTER (WHERE coalesce(nullif(m->>'authProvider', ''), 'none') <> 'none') / count(*), 1) AS \"Auth\",\n       round(100.0 * count(*) FILTER (WHERE coalesce((m->>'hasHostname')::boolean, false)) / count(*), 1) AS \"Hostname\",\n       round(100.0 * count(*) FILTER (WHERE coalesce((m->>'hasCustomAddress')::boolean, false)) / count(*), 1) AS \"Address\",\n       round(100.0 * count(*) FILTER (WHERE coalesce((m->>'hasCustomBase')::boolean, false)) / count(*), 1) AS \"Base path\",\n       round(100.0 * count(*) FILTER (WHERE coalesce((m->>'clients')::int, 0) > 1) / count(*), 1) AS \"Multi-browser\"\nFROM bucketed\nGROUP BY bucket, ord\nORDER BY ord;",
          "refId": "A",
          "sql": {
