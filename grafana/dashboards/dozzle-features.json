          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH\n  latest AS (\n    SELECT DISTINCT ON (client_id) client_id, last_metadata AS m\n    FROM daily_client_events\n    WHERE client_id <> '' AND $__timeFilter(day)\n    ORDER BY client_id, day DESC\n  )\nSELECT CASE\n             WHEN ua IS NULL OR ua = ''                        THEN 'Unknown'\n             WHEN ua LIKE '%Edg/%' OR ua LIKE '%Edge/%'        THEN 'Edge'\n             WHEN ua LIKE '%OPR/%' OR ua LIKE '%Opera%'        THEN 'Opera'\n             WHEN ua LIKE '%Firefox/%'                         THEN 'Firefox'\n             WHEN ua LIKE '%Chrome/%'                          THEN 'Chrome'\n             WHEN ua LIKE '%Safari/%'                          THEN 'Safari'\n             ELSE 'Other'\n           END AS \"Browser\", count(*)::bigint AS \"Installs\"\nFROM (SELECT m->>'browser' AS ua FROM latest) x\nGROUP BY 1\nORDER BY 2 DESC;",
