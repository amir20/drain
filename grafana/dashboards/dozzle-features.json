  "panels": [
    {
      "type": "text",
      "title": "How to read this",
      "description": "",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "**Adoption is measured per install, from its most recent beacon in the selected range.**\nFour fields in the beacon payload never come back set - `hasShell`, `remoteAgents`,\n`remoteClients` and `filterLength` are always zero/false, as are `mode` and `subCommand` -\nso they are left off these charts rather than drawn as flat zero lines. If any of those\nfeatures shipped, the beacon is not reporting them."
      }
    },
    {
      "type": "bargauge",
      "title": "Feature penetration today",
      "description": "Share of installs active in the selected range whose most recent beacon has each feature turned on. Read it as: of everyone using Dozzle right now, how many have found this.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 10,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "text",
        "namePlacement": "auto",
        "sizing": "auto",
        "minVizWidth": 8,
        "minVizHeight": 16,
        "maxVizHeight": 300,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH\n  latest AS (\n    SELECT DISTINCT ON (client_id) client_id, last_metadata AS m\n    FROM daily_client_events\n    WHERE client_id <> '' AND $__timeFilter(day)\n    ORDER BY client_id, day DESC\n  ),\n  f AS (\n    SELECT t.feature, t.enabled\n    FROM latest l\n    CROSS JOIN LATERAL (VALUES\n      ('Container actions', coalesce((l.m->>'hasActions')::boolean, false)),\n      ('Authentication', coalesce(nullif(l.m->>'authProvider', ''), 'none') <> 'none'),\n      ('Custom hostname', coalesce((l.m->>'hasHostname')::boolean, false)),\n      ('Custom address', coalesce((l.m->>'hasCustomAddress')::boolean, false)),\n      ('Custom base path', coalesce((l.m->>'hasCustomBase')::boolean, false)),\n      ('Swarm mode', coalesce((l.m->>'isSwarmMode')::boolean, false)),\n      ('Multiple browsers', coalesce((l.m->>'clients')::int, 0) > 1)\n    ) AS t(feature, enabled)\n  )\nSELECT feature AS \"Feature\",\n       round(100.0 * count(*) FILTER (WHERE enabled) / count(*), 2) AS \"Adoption\"\nFROM f\nGROUP BY 1\nORDER BY 2 DESC;",
          "refId": "A",
          "sql": {
            "columns": [],
            "groupBy": []
          }
        }
      ]
    },
