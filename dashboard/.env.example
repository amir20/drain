# Postgres/TimescaleDB the beacon writes to.
NUXT_DATABASE_URL=postgres://postgres:password@localhost:5432/drain

# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps).
# Authorization callback URL: https://<host>/auth/github
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins allowed in. Empty means nobody.
NUXT_GITHUB_ALLOWED_USERS=amir20

# Any long random string: openssl rand -base64 32
NUXT_SESSION_PASSWORD=
